# MRI_Agent_v4 — example environment
# Copy to `.env` (or just export these) and edit the paths for your machine.

# ---------------------------------------------------------------------------
# Tool bridge: where the open BCER engine repo lives
# ---------------------------------------------------------------------------
# Point this at your `BCER_open` checkout. The bridge puts this directory ITSELF
# on sys.path (BCER_open uses top-level absolute imports such as
# `from commands.registry import ToolRegistry`) and then imports
# `mri_agent_shell.tool_registry`.
#
# Both forms work:
#   BCER_ROOT=/path/to/BCER_open        <- the repo root itself (preferred)
#   BCER_ROOT=/path/to                  <- a parent dir containing `BCER_open/`
#
# If BCER_ROOT is set but does not resolve to a real checkout, the bridge reports
# status="down" instead of silently loading some other repo. If it is unset, the
# bridge auto-discovers a sibling `BCER_open/` next to this repo.
BCER_ROOT=/common/longz2/BCER_open

# Legacy aliases, still honoured (checked after BCER_ROOT / BCER_OPEN_ROOT):
# MRI_AGENT_V3_ROOT=/common/longz2/BCER_open
# MRI_AGENT_ROOT=/common/longz2/BCER_open

# Escape hatches for a differently-named engine repo layout:
# BCER_BRIDGE_MODULE=mri_agent_shell.tool_registry
# BCER_SCHEMAS_MODULE=commands.schemas

# ---------------------------------------------------------------------------
# Brain LLM (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
MRI_AGENT_V4_LLM_BASE_URL=http://127.0.0.1:8000/v1
MRI_AGENT_V4_LLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Thinking
# MRI_AGENT_V4_LLM_API_KEY=EMPTY
# MRI_AGENT_V4_LLM_TIMEOUT_S=20
# MRI_AGENT_V4_LLM_ENABLED=1
