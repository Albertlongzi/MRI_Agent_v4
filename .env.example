# MRI_Agent_v4 — example environment
# Copy to `.env` (or just export these) and edit the paths for your machine.

# ---------------------------------------------------------------------------
# Tool bridge: where the open BCER engine repo lives
# ---------------------------------------------------------------------------
# Point this at your `BCER_open` checkout. The bridge puts this directory ITSELF
# on sys.path (BCER_open uses top-level absolute imports such as
# `from commands.registry import ToolRegistry`) and then imports
# `mri_agent_shell.tool_registry`.
#
# Both forms work:
#   BCER_ROOT=/path/to/BCER_open        <- the repo root itself (preferred)
#   BCER_ROOT=/path/to                  <- a parent dir containing `BCER_open/`
#
# If BCER_ROOT is set but does not resolve to a real checkout, the bridge reports
# status="down" instead of silently loading some other repo. If it is unset, the
# bridge auto-discovers a sibling `BCER_open/` next to this repo.
BCER_ROOT=/path/to/BCER_open

# Legacy aliases, still honoured (checked after BCER_ROOT / BCER_OPEN_ROOT):
# MRI_AGENT_V3_ROOT=/path/to/BCER_open
# MRI_AGENT_ROOT=/path/to/BCER_open

# Escape hatches for a differently-named engine repo layout:
# BCER_BRIDGE_MODULE=mri_agent_shell.tool_registry
# BCER_SCHEMAS_MODULE=commands.schemas

# ---------------------------------------------------------------------------
# Remote / container tool runtime profiles
# ---------------------------------------------------------------------------
# configs/tool_runtime_profiles.json ships no site-specific values; the remote
# and Apptainer profiles reference these variables and the loader expands them.
# You only need them if you actually dispatch tools to a remote GPU host --
# the default `control-plane` and local conda profiles ignore all of it.
#
# An UNSET variable stays as the literal `${VAR}` rather than becoming empty,
# so a half-configured remote profile fails visibly instead of running somewhere
# unintended.
# MRI_AGENT_V4_GPU_HOST=gpu-node-01
# MRI_AGENT_V4_REMOTE_WORKDIR=/shared/workspace/MRI_Agent_v4
# MRI_AGENT_V4_LEGACY_PYTHON=/path/to/conda/envs/<env>/bin/python
# MRI_AGENT_V4_LEGACY_CONDA_PREFIX=/path/to/conda/envs/<env>

# ---------------------------------------------------------------------------
# Brain LLM (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
MRI_AGENT_V4_LLM_BASE_URL=http://127.0.0.1:8000/v1
# This must match the id the server advertises at /v1/models, which is the
# --served-model-name you launched it with, NOT the HuggingFace repo id. Check
# with: curl -s $MRI_AGENT_V4_LLM_BASE_URL/models | python -m json.tool
MRI_AGENT_V4_LLM_MODEL=medgemma-27b-it
# MRI_AGENT_V4_LLM_API_KEY=EMPTY
# MRI_AGENT_V4_LLM_TIMEOUT_S=20
# MRI_AGENT_V4_LLM_ENABLED=1

# ---------------------------------------------------------------------------
# Per-node chat narration
# ---------------------------------------------------------------------------
# After every node finishes, the executor appends one assistant message to
# chat_history describing what that node actually did, built from the node's
# real outputs and artifacts.
#
# There is nothing to configure. Summaries are generated deterministically and
# no model is involved: node summaries are the only place the UI states a
# clinical measurement, so they are derived from artifacts and nothing else.
# An optional "let the model reword it" layer was removed after review showed
# its guard would accept a candidate with LV and RV ejection fraction swapped,
# and would accept added interpretation such as "no evidence of infarction".
# See packages/executor/narration.py:narration_llm_enabled.
